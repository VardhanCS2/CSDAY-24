# ==========================================
# Common Goods E-commerce Environment Configuration
# ==========================================

# Database
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend API
BACKEND_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=168

# Email / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# CORS and Hosts
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,testserver
RATE_LIMIT_STORAGE_URI=redis://redis:6379/3

# Frontend
FRONTEND_PORT=80

# Optional AI Features
AI_GROQ_API_KEY=
AI_GEMINI_API_KEY=
AI_MISTRAL_API_KEY=
AI_PROVIDER_ORDER=groq,gemini,mistral
